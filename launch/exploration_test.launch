<!--
  探索测试 Launch 文件（带规划器）
  
  功能:
  1. 启动 EGO-Planner 规划器（无人机自动起飞+按预设路径点飞行）
  2. 启动探索可视化模块（实时显示前沿簇、探索视点、视锥体）
  3. 规划器控制无人机运动，探索模块仅负责可视化
  
  使用方法:
  roslaunch rog_map exploration_test.launch
  
  配置文件:
  - 所有参数统一在 config/exploration_config.yaml 中配置
  - 包含: STAR-MVF MapManager参数、EGO-Planner参数、探索状态机参数
  
  话题:
  - 输入:
    - /ground_truth/odom: 无人机里程计
    - /cloud_registered: 点云数据
    - /move_base_simple/goal: RViz 目标点（触发手动目标飞行）
  
  - 输出（规划器）:
    - /planning/pos_cmd: 位置控制命令
    - /planning/trajectory: MINCO多项式轨迹
  
  - 输出（探索可视化）:
    - /exploration/frontier_clusters: 前沿簇可视化
    - /exploration/viewpoints: 视点可视化
    - /exploration/frustums: 视锥体可视化
    - /exploration/region_route: 区域路由可视化
-->
<launch>
    <!-- ========== 统一配置文件 ========== -->
    <!-- 所有参数都在这一个文件中配置 -->
    <arg name="config_file" default="$(find rog_map)/config/exploration_config.yaml"/>
    
    <!-- ========== 话题参数 ========== -->
    <arg name="odom_topic" default="/ground_truth/odom"/>
    <arg name="cloud_topic" default="/cloud_registered"/>
    
    <!-- ========== 运行时参数覆盖（可选） ========== -->
    <!-- 飞行模式: 1=手动目标(RViz), 2=预设路径点 -->
    <arg name="flight_type" default="2"/>
    <!-- 起飞后自动开始预设路径 -->
    <arg name="auto_start" default="true"/>
    
    <!-- ========== RViz 可视化 ========== -->
    <node name="rviz_exploration" pkg="rviz" type="rviz" output="screen"
        args="-d $(find rog_map)/config/exploration_test.rviz"/>

    <!-- ========================================================== -->
    <!--                    EGO-Planner 规划器                       -->
    <!-- ========================================================== -->
    
    <!-- EGO-Planner 规划节点 -->
    <node pkg="rog_map" type="ego_planner_node" name="ego_planner_node" output="screen">
        <!-- 加载统一配置文件 -->
        <rosparam command="load" file="$(arg config_file)"/>
        
        <!-- 话题重映射 -->
        <remap from="~odom" to="$(arg odom_topic)"/>
        <remap from="~mandatory_stop" to="/mandatory_stop_to_planner"/>
        <remap from="~planning/trajectory" to="/planning/trajectory"/>
        <remap from="~planning/heartbeat" to="/traj_server/heartbeat"/>
        
        <!-- 运行时参数覆盖 -->
        <param name="fsm/flight_type" value="$(arg flight_type)"/>
        <param name="fsm/auto_start_preset" value="$(arg auto_start)"/>
        
        <!-- STAR-MVF MapManager 话题配置 -->
        <param name="rog_map/lidar_topic" value="$(arg cloud_topic)"/>
        <param name="rog_map/odom_topic" value="$(arg odom_topic)"/>
    </node>
    
    <!-- 轨迹服务器（发布控制命令） -->
    <node pkg="rog_map" type="ego_traj_server" name="ego_traj_server" output="screen">
        <!-- 加载统一配置文件 -->
        <rosparam command="load" file="$(arg config_file)"/>
        
        <!-- 话题重映射 -->
        <remap from="~odom" to="$(arg odom_topic)"/>
        <remap from="position_cmd" to="/planning/pos_cmd"/>
        <remap from="~planning/trajectory" to="/planning/trajectory"/>
        <remap from="~planning/heartbeat" to="/traj_server/heartbeat"/>
    </node>

    <!-- ========================================================== -->
    <!--                    探索可视化模块                            -->
    <!-- ========================================================== -->
    
    <!-- 探索状态机节点（被动可视化模式） -->
    <node pkg="rog_map" type="exploration_node" name="exploration_node" output="screen">
        <!-- 加载统一配置文件 -->
        <rosparam command="load" file="$(arg config_file)"/>
        
        <!-- 话题重映射 -->
        <remap from="~odom" to="$(arg odom_topic)"/>
        
        <!-- STAR-MVF MapManager 话题配置 -->
        <param name="rog_map/lidar_topic" value="$(arg cloud_topic)"/>
        <param name="rog_map/odom_topic" value="$(arg odom_topic)"/>
        
        <!-- 探索参数覆盖（被动可视化模式） -->
        <param name="exploration/auto_start" value="false"/>
        <param name="exploration/enable_visualization" value="true"/>
    </node>

    <!-- ========== TF静态发布（如果需要） ========== -->
    <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_map"
          args="0 0 0 0 0 0 world map"/> -->
          
    <!-- ========== 数据记录 (可选) ========== -->
    <!-- <node pkg="my_control_package" type="mpc_analyzer_chw.py" name="record_data" output="screen">
        <rosparam command="load" file="$(find my_control_package)/config/controller_param.yaml" ns="controller" />
    </node> -->
</launch>
