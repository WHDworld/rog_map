<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!-- 
    新架构探索规划系统启动文件
    
    架构特点：
    1. 地图更新在 lidarCallback 中完成（~10Hz）
    2. 视点生成由 ViewpointManager 定时器处理（5Hz）
    3. 历史节点由 HistoryGraph 定时器处理（2Hz）
    4. 探索状态机为4状态设计（100Hz）
    5. 规划器直接在状态机中调用，不再有单独的规划状态机
    -->
    
    <!-- ========== 参数 ========== -->
    <arg name="map_name" default="octa_maze"/>
    <arg name="sim_mode" default="0"/>  <!-- 0=Gazebo, 1=Open3D, 2=Real -->
    <arg name="auto_start" default="false"/>
    <arg name="map_visualization" default="false"/>
    <arg name="performance_logging" default="true"/>
    <arg name="fsm_visualization" default="false"/>
    
    <!-- ========== 新架构探索规划节点 ========== -->
    <node pkg="semantic_exploration" type="exploration_planner_node_new" name="exploration_planner_node" output="screen" >
        <!-- 加载参数文件到节点的私有命名空间 -->
        <rosparam file="$(find semantic_exploration)/config/exploration_new.yaml" command="load"/>
        
        <!-- 覆盖特定参数 -->
        <param name="map_name" value="$(arg map_name)"/>
        <param name="fsm/sim_mode" value="$(arg sim_mode)"/>
        <param name="exploration/auto_start" value="$(arg auto_start)"/>
        <param name="rog_map/visualization_en" value="$(arg map_visualization)"/>
        <param name="performance/enabled" value="$(arg performance_logging)"/>
        <param name="fsm/enable_visualization" value="$(arg fsm_visualization)"/>
    </node>

    
    <!-- ========== RViz 可视化 (可选) ========== -->
    <arg name="rviz" default="true"/>
    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" 
          args="-d $(find semantic_exploration)/config/exploration_open3d.rviz"/>

    <node pkg="my_control_package" type="mpc_analyzer_chw.py" name="record_data" output="screen">
        <rosparam command="load" file="$(find my_control_package)/config/controller_param.yaml" ns="controller" />
    </node>
    
</launch>
