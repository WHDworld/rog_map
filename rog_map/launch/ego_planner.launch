<!--
  EGO-Planner 轨迹规划 Launch 文件 (MINCO Trajectory)
  
  功能:
  1. 启动 ROG-Map 地图服务
  2. 启动规划 FSM（状态机管理）
  3. 启动轨迹服务器（发布控制命令）
  
  使用方法:
  roslaunch rog_map ego_planner.launch
  
  话题:
  - 输入:
    - ~odom: 无人机里程计 (nav_msgs/Odometry)
    - ~cloud: 点云数据 (sensor_msgs/PointCloud2)
    - /move_base_simple/goal: RViz 目标点 (geometry_msgs/PoseStamped)
    - /traj_start_trigger: 触发规划 (std_msgs/Empty)
  
  - 输出:
    - /planning/pos_cmd: 位置控制命令 (quadrotor_msgs/PositionCommand)
    - /planning/trajectory: MINCO多项式轨迹 (traj_utils/PolyTraj)
    - /planning/travel_traj: 执行轨迹可视化
-->
<launch>
    <!-- ========== 参数配置 ========== -->
    <arg name="config_file" default="$(find rog_map)/config/ego_planner_config.yaml"/>
    <arg name="odom_topic" default="/ground_truth/odom"/>
    <arg name="cloud_topic" default="/cloud_registered"/>
    <arg name="flight_type" default="2"/>     <!-- 1=手动, 2=预设 -->
    <arg name="auto_start" default="true"/>
    
    <!-- ========== RViz 可视化 ========== -->
    <node name="rvizvisualisation" pkg="rviz" type="rviz" output="screen"
        args="-d $(find rog_map)/config/ego_planner.rviz"/>

    <!-- ========== EGO-Planner 规划节点 ========== -->
    <node pkg="rog_map" type="ego_planner_node" name="ego_planner_node" output="screen">
        <!-- 加载配置文件 -->
        <rosparam command="load" file="$(arg config_file)"/>
        
        <!-- 话题重映射 -->
        <remap from="~odom" to="$(arg odom_topic)"/>
        <remap from="~mandatory_stop" to="/mandatory_stop_to_planner"/>
        <remap from="~planning/trajectory" to="/planning/trajectory"/>
        <remap from="~planning/heartbeat" to="/traj_server/heartbeat"/>
        
        <!-- 覆盖 FSM 参数 -->
        <param name="fsm/flight_type" value="$(arg flight_type)"/>
        <param name="fsm/auto_start_preset" value="$(arg auto_start)"/>
        
        <!-- ROG-Map 话题重映射 -->
        <param name="rog_map/ros_callback/odom_topic" value="$(arg odom_topic)"/>
        <param name="rog_map/ros_callback/cloud_topic" value="$(arg cloud_topic)"/>
    </node>
    
    <!-- ========== 轨迹服务器 ========== -->
    <node pkg="rog_map" type="ego_traj_server" name="ego_traj_server" output="screen">
        <!-- 加载配置文件 -->
        <rosparam command="load" file="$(arg config_file)"/>
        
        <!-- 话题重映射 -->
        <remap from="~odom" to="$(arg odom_topic)"/>
        <remap from="position_cmd" to="/planning/pos_cmd"/>
        <remap from="~planning/trajectory" to="/planning/trajectory"/>
        <remap from="~planning/heartbeat" to="/traj_server/heartbeat"/>
        
        <param name="traj_server/time_forward" value="1.0" type="double"/>
    </node>

    <!-- ========== 数据记录 (可选) ========== -->
    <node pkg="my_control_package" type="mpc_analyzer_chw.py" name="record_data" output="screen">
        <rosparam command="load" file="$(find my_control_package)/config/controller_param.yaml" ns="controller" />
    </node>
</launch>
